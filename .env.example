# Azure SQL connection (replace every placeholder locally; never commit real values)
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database
SQL_USERNAME=your-admin-user
SQL_PASSWORD=replace-me
SQL_APP_USERNAME=your-app-user
SQL_APP_PASSWORD=replace-me
FINPREDICT_API_URL=http://127.0.0.1:8000
FINPREDICT_API_KEY_HASHES=frontend:replace-with-sha256-hash

# Local development only; keep false or unset in production.
FINPREDICT_AUTH_DISABLED=false